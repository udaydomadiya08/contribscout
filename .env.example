# ContribScout Environment Configuration Example
# Copy this file to .env and customize as needed.
# DO NOT COMMIT YOUR REAL .env FILE WITH SECRETS.

# GitHub API Authentication (Optional for public discovery, recommended for higher rate limits)
# Standard rate limit without token: 60 requests/hour.
# With personal access token: 5,000 requests/hour.
# Minimum required scopes: public read-only (fine-grained: "Public Repositories (read-only)", classic: no scopes needed for public repos).
# Alternatively, if you have GitHub CLI authenticated (`gh auth status`), ContribScout can use `gh` automatically.
GITHUB_TOKEN=

# Optional AI Analysis Provider (Disabled by default - ContribScout works 100% deterministically without AI)
# Supported options: none, ollama, openai, openrouter, custom
AI_PROVIDER=none
AI_API_KEY=
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=llama3

# Logging and Diagnostics
CONTRIBSCOUT_LOG_LEVEL=INFO
